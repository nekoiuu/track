# ─── Supabase (Project Settings → Database → Connection string) ───
# ตัวแอปใช้ pooler (Transaction mode, port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# prisma migrate ใช้ต่อตรง (Session mode / direct, port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ─── BigSeller (ไม่บังคับ — แปะในหน้า /sync แทนก็ได้ ระบบเก็บค่าที่หมุนใหม่ลง DB ให้เอง) ───
# วิธีดึง cookie → bigseller-api/cookie/HOWTO.md  (บรรทัดเดียว ครอบด้วย " ")
BIGSELLER_COOKIE=""
REQUEST_DELAY_MS=1500

# ต่ออายุ cookie อัตโนมัติทุกกี่นาที (0 = ปิด) — ข้ามรอบถ้าเพิ่งมีการยิงจริง, หยุดเองเมื่อ cookie ตาย
BIGSELLER_KEEPALIVE_MINUTES=15
# ใช้เฉพาะตอน deploy แบบ serverless: cron เรียก GET /api/bigseller/keepalive พร้อม Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ─── Manifest ───
# เลขต้นของใบนำจ่าย — ตอนจด manifest ใส่แค่ 4 หลักท้าย (8839 → MFG963088839) · เว้นว่าง = จับคู่ด้วย 4 หลักท้ายแบบเดิม
MANIFEST_PREFIX="MFG96309"

# ─── Login ───
# สุ่มยาว ≥ 32 ตัว: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ─── Google Sheets (ปุ่ม "ส่งไป Google Sheets" — ไม่ตั้งค่า = ไม่โชว์ปุ่ม) ───
# 1) Google Cloud Console → สร้าง Service Account → Keys → Add key → JSON (ได้ไฟล์ .json)
# 2) เปิดใช้ "Google Sheets API" ในโปรเจกต์เดียวกัน
# 3) เปิดชีต → แชร์ → ใส่อีเมล service account เป็น "ผู้แก้ไข"
# รหัสชีต = ส่วนกลางของ URL: https://docs.google.com/spreadsheets/d/<รหัสนี้>/edit
GOOGLE_SHEETS_ID=""
# แท็บสร้างเองรายวัน ตั้งชื่อตามวันที่รถเข้ารับ เช่น 8OCT26 (ไม่ต้องตั้งชื่อแท็บ)
# client_email ในไฟล์ JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# private_key ในไฟล์ JSON — ก๊อปทั้งค่ารวม \n ใส่บรรทัดเดียวในเครื่องหมาย " (ห้าม commit)
GOOGLE_SERVICE_ACCOUNT_KEY=""

# ─── LINE แจ้งเตือน (Messaging API — ไม่ตั้งค่า = ไม่ส่ง ระบบอื่นทำงานปกติ) ───
# วิธีตั้งค่าทีละขั้น: เข้าเว็บด้วยบัญชีแอดมิน → เมนูบัญชี → แจ้งเตือน LINE (/line)
# LINE Developers → Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=""
# LINE Developers → Basic settings → Channel secret (ใช้ตรวจ webhook ตอนหา groupId)
LINE_CHANNEL_SECRET=""
# groupId / userId ที่จะส่งไป หลายที่คั่นด้วย , — เชิญบอทเข้ากลุ่มแล้วพิมพ์ "id" บอทจะตอบให้
LINE_TO=""
# เหตุการณ์ที่ส่ง: close = สรุปตอนปิดงาน · cancelled = ยกเลิกหลังขึ้นรถ · cookie = cookie BigSeller ใช้ไม่ได้
LINE_NOTIFY="close,cancelled,cookie"
# ลิงก์กลับเข้าเว็บในข้อความ (ไม่บังคับ) เช่น https://shipped.example.com
APP_URL=""
# 1 = ไม่ส่งจริง พิมพ์ข้อความลง log ของ server (ไว้ดูหน้าตาข้อความ)
LINE_DRY_RUN=""

# ─── รายงานสถานะพัสดุประจำวัน (LINE การ์ดสี + อัปเดตช่อง "Update" ใน Google Sheets) ───
# เวลาส่งทุกวัน (เวลาไทย HH:MM) · off = ปิดอัตโนมัติ (ยังกดส่งเองได้) — ทำงานเมื่อรันเซิร์ฟเวอร์ค้างไว้
# deploy แบบ serverless: ตั้ง cron เรียก GET /api/line/daily พร้อม Authorization: Bearer <CRON_SECRET>
LINE_DAILY_AT="00:05"
# ติดตามพัสดุที่ขึ้นรถไปไม่เกินกี่วัน
STATUS_TRACK_DAYS=14
# สถานะไม่ขยับกี่วันถึงนับว่า "ค้าง"
STATUS_STUCK_DAYS=2

# ─── สถานะพัสดุจากเว็บ Flash Express ─────────────────────────────
# ระบบยิงเลขแทร็คไปถามหน้า "เช็คสถานะพัสดุ" ของ Flash (ไม่ต้องสมัคร/ไม่ต้องมี key)
# FLASH_TRACKING_URL=https://www.flashexpress.co.th/webApi/tools/tracking
# FLASH_BATCH_SIZE=10        # เลขต่อ 1 request
# FLASH_DELAY_MS=400         # พักระหว่าง request
# FLASH_COOLDOWN_MINUTES=20 # หน้าเว็บ Flash ปฏิเสธ (403/429/หน้าตรวจบอท) → หยุดยิงหน้าเว็บกี่นาที แทนการยิงซ้ำ
# กุญแจสำหรับเรียก /api/flash/track จากภายนอก (cron / สคริปต์) — Authorization: Bearer <ค่านี้>
# FLASH_API_KEY=

# ─── อัปเดตสถานะเบื้องหลัง (src/lib/track-tick.ts) ────────────────
# ระบบเช็คสถานะเองเป็นรอบ ๆ หน้า "ติดตามสถานะ" อ่านจากฐานข้อมูลได้เลย ไม่ต้องรอยิงถามตอนเปิดหน้า
# ทำงานเมื่อรันเซิร์ฟเวอร์ค้างไว้ · deploy แบบ serverless: ตั้ง cron เรียก GET /api/track/tick พร้อม Authorization: Bearer <CRON_SECRET>
# TRACK_TICK_MINUTES=15          # ทุกกี่นาที (0 = ปิด แล้วกลับไปเช็คตอนเปิดหน้าแบบเดิม)
# TRACK_TICK_FLASH_LIMIT=400     # เช็ค Flash ต่อรอบไม่เกินกี่ชิ้น (เก่าสุดก่อน)
# TRACK_FLASH_STALE_MINUTES=120  # ชิ้นที่เพิ่งเช็คไม่ถึงกี่นาทีไม่ต้องเช็คซ้ำ
# TRACK_BS_STALE_MINUTES=60      # ดึงสถานะ BigSeller (SPX / จับยกเลิก) ซ้ำทุกกี่นาทีต่อใบ
# TRACK_TICK_BS_MANIFESTS=20     # ดึง BigSeller ต่อรอบไม่เกินกี่ใบ
# AUTO_FLASH_MINUTES=            # เปิดหน้าติดตามสถานะแล้วเช็ค Flash ให้เอง เฉพาะชิ้นที่ข้อมูลเก่ากว่านี้
#                                #   ไม่ตั้ง = 360 ถ้ารอบเบื้องหลังทำงานอยู่ · 30 ถ้าไม่มี
# TRACKER_INTERVAL_SCALE=1       # คูณระยะคิวเช็ค Flash ซ้ำทุกสถานะ (2 = เช็คห่างลงครึ่งหนึ่ง · 0.5 = ถี่ขึ้นเท่าตัว)
